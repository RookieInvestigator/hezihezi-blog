---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, tags } = data;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="flex items-center gap-2.5 py-2">
  <Datetime
    pubDatetime={data.pubDatetime}
    modDatetime={data.modDatetime}
    timezone={data.timezone}
    format="YYYY/MM/DD"
    class="shrink-0"
  />
  <div class="min-w-0 flex-1 truncate">
    <a
      href={getPostUrl(id, filePath, locale)}
      class="hover-underline"
    >
      <Heading class="inline text-[15px] font-normal">{title}</Heading>
    </a>
  </div>
  {
    tags && tags.length > 0 && (
      <div class="text-muted-foreground hidden shrink-0 items-center gap-2 text-xs sm:flex">
        {tags.map(tag => (
          <a
            href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
            class="hover-underline"
          >
            {tag}
          </a>
        ))}
      </div>
    )
  }
</li>
