---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 py-4 text-sm"
  >
    <span class="tabular-nums">© {currentYear} {config.site.author}</span>
    <Socials />
    <a
      href={getRelativeLocaleUrl(locale, "rss.xml")}
      class="hover-underline"
    >
      RSS
    </a>
  </div>
</footer>
