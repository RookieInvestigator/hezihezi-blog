---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  format?: string;
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  format = "YYYY-MM-DD",
  class: className,
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const date = datetime.format(format);
---

<span
  class:list={[
    "text-muted-foreground tabular-nums",
    { "text-xs": size === "sm", "text-sm": size === "lg" },
    className,
  ]}
>
  {isModified && <span class="me-1.5">{t.post.updatedAt}</span>}
  <time datetime={datetime.toISOString()}>{date}</time>
</span>
