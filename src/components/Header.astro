---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const navItems = [
  { path: "posts", label: t.nav.posts },
  { path: "tags", label: t.nav.tags },
  { path: "works", label: t.nav.works },
  { path: "stats", label: t.nav.stats },
  { path: "about", label: t.nav.about },
];

if (features.showArchives) {
  navItems.push({ path: "archives", label: t.nav.archives });
}
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-foreground absolute inset-s-3.5 -top-full z-50 py-2 text-sm focus:top-0"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-8 sm:py-10"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="hover-underline text-[15px]"
    >
      {site.title}
    </a>

    <nav>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[15px]">
        {
          navItems.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.path)}
                class="hover-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          features.search !== false && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "search")}
                class="hover-underline"
              >
                {t.nav.search}
              </a>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="flex items-center">
              <button
                id="theme-btn"
                class="text-muted-foreground hover:text-foreground relative flex size-4 items-center justify-center transition-colors"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
