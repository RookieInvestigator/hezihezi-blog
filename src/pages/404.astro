---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout pb-10">
    <h1 class="text-title text-[17px] font-bold">404</h1>
    <p class="text-muted-foreground mt-1 text-sm">{t.notFound.message}</p>
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="hover-underline mt-6 inline-block text-[15px]"
    >
      {t.notFound.goHome}
    </a>
  </main>

  <Footer />
</Layout>
