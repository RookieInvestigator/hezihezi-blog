---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { works } from "@/data/works";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.worksTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.worksTitle} pageDesc={t.pages.worksDesc}>
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        works.map(work => (
          <li class="border-border bg-background flex flex-col overflow-hidden rounded-none border-2 transition-colors hover:border-accent">
            {work.cover ? (
              <img
                src={work.cover}
                alt={work.title}
                loading="lazy"
                class="aspect-video w-full object-cover"
              />
            ) : (
              <div
                aria-hidden="true"
                class="aspect-video w-full bg-gradient-to-br from-accent/70 via-accent/30 to-transparent"
              />
            )}
            <div class="flex flex-1 flex-col gap-3 p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-lg font-bold">{work.title}</h2>
                {work.period && (
                  <span class="text-muted-foreground shrink-0 text-xs">
                    {work.period}
                  </span>
                )}
              </div>
              <p class="text-muted-foreground text-sm leading-7">
                {work.description}
              </p>
              {work.tech.length > 0 && (
                <p class="text-xs">
                  <span class="text-muted-foreground">{t.pages.worksStack}：</span>
                  {work.tech.join(" / ")}
                </p>
              )}
              <div class="mt-auto flex gap-4 pt-1 text-sm font-medium">
                {work.demo && (
                  <a
                    href={work.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:underline"
                  >
                    {t.pages.worksViewDemo} →
                  </a>
                )}
                {work.repo && (
                  <a
                    href={work.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:underline"
                  >
                    {t.pages.worksViewRepo} →
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
