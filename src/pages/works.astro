---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { works } from "@/data/works";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.worksTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.worksTitle} pageDesc={t.pages.worksDesc}>
    <ul class="flex flex-col">
      {
        works.map(work => (
          <li class="border-border border-t py-8 first:border-t-0 first:pt-0">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
              {work.cover && (
                <img
                  src={work.cover}
                  alt={work.title}
                  loading="lazy"
                  class="border-border w-full border object-cover sm:order-2 sm:w-44 sm:shrink-0"
                />
              )}
              <div class="flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="text-[15px] font-bold">
                    {work.title}
                  </h2>
                  <span
                    class="text-muted-foreground shrink-0 text-xs tabular-nums"
                  >
                    {[work.period, work.role].filter(Boolean).join(" · ")}
                  </span>
                </div>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {work.description}
                </p>
                {work.tags.length > 0 && (
                  <div class="text-muted-foreground mt-2 flex flex-wrap gap-x-3 text-xs">
                    {work.tags.map(tag => (
                      <span>#{tag}</span>
                    ))}
                  </div>
                )}
                <div class="mt-4 flex gap-5 text-sm">
                  {work.demo && (
                    <a
                      href={work.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border-b border-border pb-0.5 transition-colors hover:border-foreground"
                    >
                      {t.pages.worksViewDemo}
                    </a>
                  )}
                  {work.repo && (
                    <a
                      href={work.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border-b border-border pb-0.5 transition-colors hover:border-foreground"
                    >
                      {t.pages.worksViewRepo}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
