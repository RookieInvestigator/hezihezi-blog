---
import LinkButton from "@/components/LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const pageUrl = Astro.url;

const platformLabel = (name: string) =>
  name === "mail" ? "邮件" : name.charAt(0).toUpperCase() + name.slice(1);

const items = shareLinks.map(({ name, url, linkTitle }) => ({
  href: `${url}${pageUrl}`,
  label: linkTitle ?? platformLabel(name),
  external: !url.startsWith("mailto:"),
}));
---

{
  items.length > 0 && (
    <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <span class="text-xs">{t.post.sharePostIntro}</span>
      {items.map(({ href, label, external }) => (
        <a
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
          class="transition-colors hover:text-foreground"
        >
          {label}
        </a>
      ))}
    </div>
  )
}
