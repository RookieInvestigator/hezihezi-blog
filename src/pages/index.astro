---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");

const groups = new Map<number, typeof sortedPosts>();
for (const post of sortedPosts) {
  const year = post.data.pubDatetime.getFullYear();
  const group = groups.get(year);
  if (group) group.push(post);
  else groups.set(year, [post]);
}
const years = [...groups.keys()].sort((a, b) => b - a);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-10"
  >
    <section class="text-[14px] leading-[2]">
      <p>阳里禾子的个人堆放处。</p>
    </section>

    <div class="mt-10">
      {
        years.map(year => (
          <section class="mt-8 first:mt-0">
            <h2 class="text-[15px] font-bold tabular-nums">{year}</h2>
            <ul class="mt-1">
              {groups.get(year)?.map(data => <Card {...data} />)}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
